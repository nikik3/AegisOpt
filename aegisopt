#!/usr/bin/env python3
import argparse
import sys
import os

# Ensure the library path is set up correctly when running as a global tool
sys.path.append(os.path.dirname(os.path.abspath(__file__)))
from mape_loop import MAPEManager

def main():
    parser = argparse.ArgumentParser(description="aegisopt - Agentic AI-Driven Compiler")
    parser.add_argument("input_file", help="Input C/C++ source code file")
    parser.add_argument("-o", "--output", default="a.out", help="Place the output into <file>")
    parser.add_argument("--agent", default="RL", choices=["RL", "RuleBased", "LLM"], help="AI Optimization agent to drive the compilation (Default: RL)")
    parser.add_argument("--steps", type=int, default=3, help="Number of autonomous phase ordering exploration steps")
    parser.add_argument("--unsafe", action="store_true", help="Disable the Security Radar (SAST) checks")
    
    args = parser.parse_args()
    
    if not os.path.exists(args.input_file):
        print(f"aegisopt: error: {args.input_file}: No such file or directory")
        sys.exit(1)
        
    print(f"🛡️  AegisOpt Compiler Framework (v1.0.0-RL)")
    print(f"[*] Target      : {args.input_file}")
    print(f"[*] AI Agent    : {args.agent} (Steps: {args.steps})")
    print(f"[*] Security    : {'DISABLED' if args.unsafe else 'ENABLED'}")
    print("-" * 50)
    
    try:
        manager = MAPEManager(
            program_path=args.input_file, 
            security_mode=not args.unsafe, 
            sanitizer_mode=False
        )
        
        # 1. Run baseline
        baseline = manager.run_baseline()
        print(f"[Baseline] Standard GCC (-O3) Latency: {baseline:.4f}s")
        
        # 2. Run sequential phase ordering
        print(f"[Agentic Loop] Engaging Neural Space Exploration...")
        
        # Suppress heavy stdout from the framework scripts to make it look like a clean compiler
        manager.run_sequential_cycle(agent_type=args.agent, steps=args.steps)
        
        history = manager.history.history
        final_latency = history[-1]["latency"]
        improvement = ((baseline - final_latency) / baseline) * 100
        
        # Find the final optimal passes chosen
        passes_used = []
        for entry in history[1:]:
             if entry.get("accepted", False):
                  action = entry.get("action") or entry.get("strategy")
                  if action:
                       passes_used.append(action)
        
        print("-" * 50)
        print(f"✅ Compilation Successfully Finalized")
        
        if passes_used:
            print(f"[*] Discovered Optimal Pass Sequence -> [{' -> '.join(passes_used)}]")
            
        if improvement > 0:
            print(f"📈 [SUCCESS] AegisOpt Binary is {improvement:.2f}% FASTER than standard GCC -O3!")
        else:
            print(f"⚖️  [FALLBACK] Standard GCC (-O3) heuristics proved optimally stable. Reverting to baseline.")
            
        # Clean up output binary
        if os.path.exists("program_opt"):
            os.rename("program_opt", args.output)
            print(f"🎯 Binary safely written to: ./{args.output}")
            
    except Exception as e:
        print(f"aegisopt: fatal error: {str(e)}")
        sys.exit(1)

if __name__ == "__main__":
    main()
