#!/usr/bin/env python3
import argparse
import sys
import os
import time

sys.path.append(os.path.dirname(os.path.abspath(__file__)))
from mape_loop import MAPEManager

def main():
    parser = argparse.ArgumentParser(description="aegisopt - Agentic AI-Driven Compiler")
    parser.add_argument("input_file", help="Input C/C++ source code file")
    parser.add_argument("-o", "--output", default="a.out", help="Place the output into <file>")
    parser.add_argument("--agent", default="RL", choices=["RL", "RuleBased", "LLM"], help="AI Optimization agent")
    parser.add_argument("--steps", type=int, default=2, help="Exploration steps")
    parser.add_argument("--unsafe", action="store_true", help="Disable SAST checks")
    
    args = parser.parse_args()
    
    if not os.path.exists(args.input_file):
        print(f"aegisopt: error: {args.input_file}: No such file or directory")
        sys.exit(1)
        
    start_time = time.time()
    
    # SILENCE ALL ORCHESTRATOR OUTPUT
    original_stdout = sys.stdout
    original_stderr = sys.stderr
    sys.stdout = open(os.devnull, 'w')
    sys.stderr = open(os.devnull, 'w')
    
    try:
        manager = MAPEManager(
            program_path=args.input_file, 
            security_mode=not args.unsafe, 
            sanitizer_mode=False
        )
        manager.run_baseline()
        manager.run_sequential_cycle(agent_type=args.agent, steps=args.steps)
        
        if os.path.exists("program_opt"):
            os.rename("program_opt", args.output)
            
    except Exception as e:
        sys.stdout.close()
        sys.stderr.close()
        sys.stdout = original_stdout
        sys.stderr = original_stderr
        print(f"aegisopt: fatal error: {str(e)}")
        sys.exit(1)
        
    # RESTORE OUTPUT
    sys.stdout.close()
    sys.stderr.close()
    sys.stdout = original_stdout
    sys.stderr = original_stderr
    compilation_time = time.time() - start_time

    # EXECUTE THE COMPILED BINARY DIRECTLY TO STDOUT
    if os.path.exists(args.output):
        os.system(f"./{args.output}")
        print(f"\n[AegisOpt] Compiled autonomously in {compilation_time:.2f}s")
    else:
        print("aegisopt: error: compilation failed silently.")

if __name__ == "__main__":
    main()
